# ============================================================
# GRC CREST - COMMAND CENTER — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# Add variables to your hosting platform for production.
# NEVER commit .env.local to version control.
# ============================================================

APP_ENV=development
PORT=3000

# ── NextAuth ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Must be at least 32 characters. Keep secret.
AUTH_SECRET=replace_with_32_char_random_string

# The full URL of your deployed application.
# Auth.js v5 reads AUTH_URL. NEXTAUTH_URL is included for compatibility
# with older NextAuth integrations and ecosystem tooling.
# Local: http://localhost:3000
# Production: https://your-domain.com
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Allows Auth.js to trust the host header in local/proxied deployments.
# Set this explicitly in environments such as Vercel, Docker, or reverse proxies.
AUTH_TRUST_HOST=true


# ── Authorised Users ─────────────────────────────────────────
# JSON array of authorised staff. No registration flow exists.
# Accounts are created by administrators and distributed to
# authorised staff through the organisation's IAM processes.
#
# Generating a bcrypt hash (run in terminal):
#   node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
#
# mfaMethod: "totp" = Google Authenticator app
#            "email" = code sent to email address
# totpSecret: null until user completes TOTP setup on first login
#             Generate with: node -e "require('otplib').authenticator.generateSecret()"
#
AUTHORISED_USERS='[
  {
    "id": "usr_001",
    "email": "analyst@yourcompany.com",
    "name": "Jane Smith",
    "role": "analyst",
    "hashedPassword": "$2a$12$replace_with_bcrypt_hash",
    "totpSecret": null,
    "mfaMethod": "totp"
  },
  {
    "id": "usr_002",
    "email": "admin@yourcompany.com",
    "name": "John Admin",
    "role": "admin",
    "hashedPassword": "$2a$12$replace_with_bcrypt_hash",
    "totpSecret": "JBSWY3DPEHPK3PXP",
    "mfaMethod": "totp"
  }
]'


# ── TOTP Configuration ────────────────────────────────────────
# The issuer name shown in the authenticator app (e.g. Google Authenticator)
TOTP_ISSUER=GRC Crest - Command Center


# ── Email (SMTP) — for Email OTP MFA method ──────────────────
# Any SMTP provider works: Gmail, Outlook, SendGrid, Mailgun, etc.
#
# Gmail example (use an App Password, not your main password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your_app_password
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=your_sendgrid_api_key
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@yourcompany.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM_NAME=GRC Crest - Command Center


# ── AI Provider ───────────────────────────────────────────────
# Options: "claude" | "openai" | "custom"
AI_PROVIDER=claude

# Model identifier for the active provider:
#   Claude:  claude-sonnet-4-20250514 | claude-opus-4-5
#   OpenAI:  gpt-4o | gpt-4o-mini | gpt-4-turbo
AI_MODEL=claude-sonnet-4-20250514

# Max tokens in AI completion responses
AI_MAX_TOKENS=1000

# Anthropic API key (required when AI_PROVIDER=claude)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI API key (required when AI_PROVIDER=openai or custom)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_key_here

# Custom LLM endpoint (required when AI_PROVIDER=custom)
# Must be OpenAI-compatible (Ollama, Azure OpenAI, vLLM, etc.)
CUSTOM_LLM_ENDPOINT=

# ── Public env vars (safe for browser — NO secrets) ──────────
# Shows active AI provider label in the dashboard header
NEXT_PUBLIC_AI_PROVIDER=claude
